# PostgreSQL connection string (required for migrations and PDF ingestion inserts)
# Example: postgresql://user:password@localhost:5432/qa_pilot
DATABASE_URL=

# Anthropic API key (server-side only — never use NEXT_PUBLIC_)
ANTHROPIC_API_KEY=

# Claude Haiku model for query understanding (Phase 3)
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5-20251001

# Claude Sonnet model for answer generation (Phase 6)
ANTHROPIC_SONNET_MODEL=claude-sonnet-4-6
